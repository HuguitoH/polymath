# Database 
# The app and Alembic both build the DSN from this via Settings.database_url.
DB_PASSWORD=

# Provider keys 
# litellm and huggingface_hub read these from the process environment,
# not from Settings: export them, or load this file with EnvironmentFile=
# in the systemd unit.
DEEPSEEK_API_KEY=

# Only needed for the first Kokoro model download from Hugging Face.
HF_TOKEN=

# Optional overrides (defaults live in src/polymath/config.py)
# MODEL=deepseek/deepseek-chat
# MODEL_IS_LOCAL=false
# REASONING_MODEL=ollama_chat/qwen3:4b
# EMBEDDING_MODEL=bge-m3
# TTS_VOICE=af_bella
# AUDIO_DIR=/srv/fast/audio
